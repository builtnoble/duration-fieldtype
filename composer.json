{
    "name": "builtnoble/duration-fieldtype",
    "description": "A Statamic fieldtype for storing and displaying time durations as millisecond-precision integers, entered via a masked hh:mm input.",
    "keywords": ["statamic", "statamic-addon", "fieldtype", "duration", "time"],
    "license": "MIT",
    "authors": [
        {
            "name": "Amanda Romero",
            "email": "thetypescriptslayer@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Builtnoble\\DurationFieldtype\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Builtnoble\\DurationFieldtype\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^4.6"
    },
    "scripts": {
        "test": "pest",
        "test:feature": "pest --group=\"feature\"",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse",
        "check": ["@lint", "@analyse", "@test"]
    },
    "support": {
        "issues": "https://github.com/builtnoble/duration-fieldtype/issues",
        "source": "https://github.com/builtnoble/duration-fieldtype"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Duration Fieldtype",
            "description": "A Statamic fieldtype for storing and displaying time durations as millisecond-precision integers, entered via a masked hh:mm input.",
            "editions": ["free"]
        },
        "laravel": {
            "providers": ["Builtnoble\\DurationFieldtype\\ServiceProvider"]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}