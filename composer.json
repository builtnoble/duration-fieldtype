{
    "name": "builtnoble/duration-fieldtype",
    "authors": [
        {
            "name": "Amanda Romero",
            "email": "thetypescriptslayer@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Builtnoble\\DurationFieldtype\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Builtnoble\\DurationFieldtype\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.8",
        "pestphp/pest": "^4.6"
    },
    "scripts": {
        "test": "pest",
        "test:feature": "pest --group=\"feature\"",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Duration Fieldtype",
            "description": "Duration Fieldtype addon",
            "editions": ["free"]
        },
        "laravel": {
            "providers": ["Builtnoble\\DurationFieldtype\\ServiceProvider"]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}